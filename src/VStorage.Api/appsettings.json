{
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "VStorage": {
    "PublicBaseUrl": "",
    "Storage": {
      "BlobRoot": "./data",
      "MaxUploadBytes": 1073741824,
      "MinFreeDiskBytes": 5368709120
    },
    "Auth": {
      "Authority": "",
      "Audience": "vstorage",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 30,
      "RolesClientId": "vstorage",
      "AdminRole": "vstorage-admin",
      "BucketCreatorRole": "bucket-creator",
      "ScalarClientId": "vstorage-scalar",
      "Oidc": {
        "ClientId": "vstorage"
      }
    },
    "ShareLinks": {
      "DefaultExpiresIn": "30.00:00:00",
      "MaxExpiresIn": "365.00:00:00",
      "PublicSlugLength": 12,
      "AddressedSlugLength": 8
    },
    "DownloadLinks": {
      "DefaultLifetimeSeconds": 300,
      "MaxLifetimeSeconds": 3600
    },
    "DataProtection": {
      "KeysPath": "./keys"
    },
    "Cleanup": {
      "SoftDeleteRetentionDays": 30,
      "PendingTimeoutMinutes": 60,
      "WorkerIntervalSeconds": 60,
      "OutboxPollIntervalSeconds": 10
    },
    "Docs": {
      "Enabled": false
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/vstorage-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:o} [{Level:u3}] [{ApplicationName}] {CorrelationId} {SourceContext} {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "ApplicationName": "vstorage-api"
    }
  },
  "AllowedHosts": "*"
}
