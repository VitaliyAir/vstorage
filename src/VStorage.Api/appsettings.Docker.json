{
  // Container settings (ASPNETCORE_ENVIRONMENT=Docker, see D:\Family\Developer\VDocker). No secrets here: the
  // connection string and the OIDC client secret come from the stack's .env file.
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "VStorage": {
    // Overridden by the compose file with the published port (VSTORAGE_PORT); http only in Docker.
    "PublicBaseUrl": "http://localhost:5190",
    "Storage": {
      // D:\Family\Developer\VStorageAPI\data mounted by the compose file (same files as dev).
      "BlobRoot": "/data"
    },
    "DataProtection": {
      // D:\Family\Developer\VStorageAPI\keys mounted: download/share tokens stay valid between dev and Docker.
      "KeysPath": "/keys"
    },
    "Auth": {
      // The issuer as the browser sees it; the API itself reaches Keycloak through InternalAuthority.
      "Authority": "http://localhost:8083/realms/VEco",
      "InternalAuthority": "http://host.docker.internal:8083",
      "RequireHttpsMetadata": false
    },
    "Docs": {
      "Enabled": true
    }
  }
}
