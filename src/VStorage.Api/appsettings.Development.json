{
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "VStorage": {
    "PublicBaseUrl": "https://localhost:7190",
    "Storage": {
      // D:\Family\Developer\VStorageAPI\data (relative to src\VStorage.Api)
      "BlobRoot": "../../data"
    },
    "DataProtection": {
      // D:\Family\Developer\VStorageAPI\keys (relative to src\VStorage.Api)
      "KeysPath": "../../keys"
    },
    "Auth": {
      "Authority": "http://localhost:8083/realms/VEco",
      "RequireHttpsMetadata": false
    },
    "Docs": {
      "Enabled": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
